# ── Credentials (required) ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# ── Models (optional overrides) ──────────────────────────────────────────────
# CHAT_MODEL=gpt-5-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# ── Chunking (optional overrides) ────────────────────────────────────────────
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200

# ── Retrieval (optional overrides) ───────────────────────────────────────────
# RETRIEVAL_TOP_K=4
# MAX_RETRIEVAL_ATTEMPTS=3
# MAX_QUERY_REWRITES=1
# COLLECTION_PREFIX=paperpilot

# ── Web search (optional overrides) ──────────────────────────────────────────
# WEB_SEARCH_MAX_RESULTS=3
# VERIFICATION_MAX_RESULTS=5
# MAX_SUPERSEDING_PAPERS=3

# ── Observability ────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
